# Hub Astorya — variables d'environnement (OVH). COPIER en .env et RENSEIGNER.
# ⚠️ Ne jamais committer le .env réel (déjà couvert par .gitignore).

# Domaines
PUBLIC_ORIGIN=https://hub.astorya.fr
GIT_DOMAIN=git.astorya.fr
HUB_REPO_PATH=/opt/hub-astorya          # chemin du dépôt cloné sur le serveur

# Supabase self-hosted (valeurs générées par le compose officiel Supabase)
SUPABASE_URL=https://supabase.astorya.fr
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
PGHOST=supabase-db
PGUSER=postgres
PGDATABASE=postgres

# Services externes
PAPPERS_API_TOKEN=
DROPCONTACT_API_KEY=
BRAVE_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=notifications@astorya.fr
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
CX_WEBHOOK_SECRET=

# Sauvegarde hors-site (à répliquer : OVH Backup Storage / rsync distant)
BACKUP_RETENTION_DAYS=14
